# Development-mode only. Vite loads this on top of `.env` when running
# `npm run dev` (mode=development) and ignores it for `npm run build`
# (mode=production), so the deployed URL in `.env` is used for real builds.
#
# No secrets here, which is why this file is committed (see .gitignore).
# It holds no credentials - only which backend the dev server talks to.

# Same-origin path: the Vite dev server proxies /graphql to
# http://localhost:8000 (vite.config.js). Use this when you run the Django
# backend locally - no CORS preflight, so it works regardless of the
# backend's CORS allow list. Start the backend with:
#   cd backend && python manage.py runserver
VITE_GRAPHQL_URL=/graphql

# To develop against the deployed API instead, comment the line above and
# uncomment this one, then restart `npm run dev` (Vite only reads env files
# at startup). The deployed backend must allow this origin; see
# backend/backend/settings.py CORS_ALLOWED_ORIGINS.
# VITE_GRAPHQL_URL=https://vistaforge.onrender.com/graphql
