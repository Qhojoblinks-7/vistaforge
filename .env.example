# Frontend Environment Variables Template
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Render, Vercel, etc.)

# API Configuration
#
# VITE_GRAPHQL_URL is resolved per Vite mode:
#   - Development (`npm run dev`): .env.development is loaded on top of this
#     file and sets VITE_GRAPHQL_URL=/graphql, a same-origin path that the Vite
#     dev server proxies to http://localhost:8000. Comment it out there to use
#     the absolute deployed URL below instead.
#   - Production (`npm run build`): only this file and .env.production are read.
#
# A production build MUST set an absolute URL - a relative /graphql only works
# where the host rewrites it to the API (the Render static site does; Vercel
# needs the real API origin).
VITE_API_URL=https://vistaforge.onrender.com/api
VITE_GRAPHQL_URL=https://vistaforge.onrender.com/graphql

# App Configuration
VITE_APP_NAME=VistaForge
VITE_APP_ENV=production

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID
VITE_PLAUSIBLE_DOMAIN=your_domain.com

# Calendly (Optional)
VITE_CALENDLY_URL=https://calendly.com/your-username/30min

# Social Media Links
VITE_LINKEDIN_URL=https://linkedin.com/company/vistaforge
VITE_INSTAGRAM_URL=https://instagram.com/vistaforge
VITE_TWITTER_URL=https://twitter.com/vistaforge

# Contact Information
VITE_CONTACT_EMAIL=hello@vistaforge.com
VITE_CONTACT_PHONE=+233 XX XXX XXXX

# Business Information
VITE_BUSINESS_ADDRESS=Accra, Ghana